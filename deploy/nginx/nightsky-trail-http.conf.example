# Temporary HTTP-only configuration used to obtain the first TLS certificate.
server {
    listen 80;
    listen [::]:80;
    server_name trail.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
