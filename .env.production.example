# Compose settings
NIGHTSKY_DATA_DIR=/opt/nightsky-trail/data
NIGHTSKY_EDGE_NETWORK=bantigerjersey_webnet
NIGHTSKY_IMAGE_TAG=local

# Django
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=trail.example.com,nightsky_backend,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://trail.example.com
DJANGO_SESSION_COOKIE_AGE_SECONDS=1209600
PLANNER_LOG_LEVEL=INFO

# Transactional email through Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_SMTP_USE_TLS=true
BREVO_SMTP_TIMEOUT_SECONDS=10
DEFAULT_FROM_EMAIL=noreply@trail.example.com
PUBLIC_APP_URL=https://trail.example.com
MONITORING_REPORT_RECIPIENTS=admin@example.com
MONITORING_REPORT_LOOKBACK_HOURS=24
DATABASE_BACKUP_DIR=/data/app/backups
DATABASE_BACKUP_KEEP=14
AUTH_TOKEN_TIMEOUT_SECONDS=1800

# Authentication limits
AUTH_LOGIN_RATE_LIMIT=8
AUTH_LOGIN_RATE_WINDOW_SECONDS=300
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_RATE_LIMIT=5
AUTH_PASSWORD_RESET_RATE_WINDOW_SECONDS=3600

# External services
GRAPHHOPPER_PROFILE=hike
GRAPHHOPPER_TIMEOUT_SECONDS=10
SWISSTOPO_BASE_URL=https://api3.geo.admin.ch
SWISSTOPO_TIMEOUT_SECONDS=10
OVERPASS_BASE_URL=https://overpass-api.de/api
OVERPASS_TIMEOUT_SECONDS=12

# Trail data and cache behaviour
SWISSTOPO_TRAILS_URL=https://data.geo.admin.ch/ch.swisstopo.swisstlm3d-wanderwege/swisstlm3d-wanderwege/swisstlm3d-wanderwege_2056_5728.gpkg.zip
SWISSTOPO_TRAILS_TIMEOUT_SECONDS=60
TRAILS_CACHE_TIMEOUT_SECONDS=300
TRAILS_CACHE_BBOX_DECIMALS=3
TRAILS_DEBUG_MIN_ZOOM=15
TRAILS_DEBUG_MAX_BBOX_AREA=0.004
